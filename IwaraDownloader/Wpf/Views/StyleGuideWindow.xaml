<Window x:Class="IwaraDownloader.Wpf.Views.StyleGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:IwaraDownloader.Wpf.Markup"
        Title="{loc:T StyleGuide_Title}"
        Icon="pack://siteoforigin:,,,/icon.ico"
        Width="520" Height="480"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:T StyleGuide_Heading}"
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,8" />

        <TextBlock Grid.Row="1" Text="{loc:T StyleGuide_Description}"
                   Foreground="{DynamicResource Brush.TextSecondary}"
                   TextWrapping="Wrap" Margin="0,0,0,16" />

        <Border Grid.Row="2" Background="{DynamicResource Brush.BackgroundElevated}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                CornerRadius="{DynamicResource CornerRadius.Default}"
                Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{loc:T StyleGuide_TextBoxLabel}" Margin="0,0,0,4" />
                <TextBox Text="{Binding SampleText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6"
                         Background="{DynamicResource Brush.Background}"
                         Foreground="{DynamicResource Brush.Text}"
                         BorderBrush="{DynamicResource Brush.Border}"
                         Margin="0,0,0,12" />

                <Button Content="{loc:T StyleGuide_ButtonSample}"
                        Padding="12,6"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource Brush.Accent}"
                        Foreground="{DynamicResource Brush.OnAccent}"
                        BorderThickness="0" />
            </StackPanel>
        </Border>

        <Button Grid.Row="3" Content="{loc:T StyleGuide_ToggleTheme}"
                Command="{Binding ToggleThemeCommand}"
                Padding="12,6" HorizontalAlignment="Left"
                Background="{DynamicResource Brush.BackgroundHover}"
                Foreground="{DynamicResource Brush.Text}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1" Margin="0,0,0,16" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,8">
            <Ellipse Width="14" Height="14" Fill="{DynamicResource Brush.Success}" Margin="0,0,6,0" />
            <TextBlock Text="Completed" Margin="0,0,16,0" />
            <Ellipse Width="14" Height="14" Fill="{DynamicResource Brush.Warning}" Margin="0,0,6,0" />
            <TextBlock Text="Pending" Margin="0,0,16,0" />
            <Ellipse Width="14" Height="14" Fill="{DynamicResource Brush.Danger}" Margin="0,0,6,0" />
            <TextBlock Text="Failed" Margin="0,0,16,0" />
            <Ellipse Width="14" Height="14" Fill="{DynamicResource Brush.Favorite}" Margin="0,0,6,0" />
            <TextBlock Text="Favorite" />
        </StackPanel>

        <TextBlock Grid.Row="5" Text="{Binding CurrentTheme}" VerticalAlignment="Bottom"
                   Foreground="{DynamicResource Brush.TextDisabled}" FontSize="11" />
    </Grid>
</Window>
