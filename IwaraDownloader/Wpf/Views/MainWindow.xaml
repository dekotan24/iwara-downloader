<Window x:Class="IwaraDownloader.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:IwaraDownloader.Wpf.Markup"
        Title="IwaraDownloader"
        Icon="pack://siteoforigin:,,,/icon.ico"
        Width="1200" Height="750"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <!--
        Phase4a: レイアウトシェルのみ。中身(チャンネルツリー/動画一覧/ツールバー等)は
        Phase4b〜4fで順次埋める。旧WinForms版の構造(MainForm.Designer.cs)に対応:
          toolStrip(上) / mainSplitContainer.Panel1(URL入力行) /
          contentSplitContainer(左=チャンネルツリー, 右=動画一覧) / statusStrip(下)
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" x:Name="ToolbarRow" />
            <RowDefinition Height="Auto" x:Name="UrlInputRow" />
            <RowDefinition Height="*" x:Name="ContentRow" />
            <RowDefinition Height="Auto" x:Name="StatusBarRow" />
        </Grid.RowDefinitions>

        <!-- ツールバー -->
        <Border Grid.Row="0" x:Name="ToolbarHost"
                Background="{DynamicResource Brush.BackgroundElevated}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                Padding="6">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="Margin" Value="0,0,4,0" />
                        <Setter Property="Background" Value="{DynamicResource Brush.BackgroundHover}" />
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                        <Setter Property="BorderThickness" Value="1" />
                    </Style>
                </StackPanel.Resources>
                <Button Content="今すぐ確認" Command="{Binding CheckNowCommand}" />
                <Button Content="DL開始" Command="{Binding StartAllCommand}" />
                <Button Content="停止" Command="{Binding StopAllCommand}" />
                <Separator Margin="4,0" />
                <Button Content="一括インポート" Command="{Binding OpenBulkImportCommand}" />
                <Button Content="検索インポート" Command="{Binding OpenSearchImportCommand}" />
                <Button Content="フォルダ取込" Command="{Binding OpenImportFromFolderCommand}" />
                <Button Content="重複チェック" Command="{Binding OpenDuplicateCheckCommand}" />
                <Button Content="統計" Command="{Binding OpenStatisticsCommand}" />
                <Separator Margin="4,0" />
                <Button Content="設定" Command="{Binding OpenSettingsCommand}" />
                <Button Content="バージョン情報" Command="{Binding OpenAboutCommand}" />
            </StackPanel>
        </Border>

        <!-- URL入力行 -->
        <Border Grid.Row="1" x:Name="UrlInputHost"
                Background="{DynamicResource Brush.Background}"
                Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="UrlTextBox"
                         Text="{Binding UrlInput, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6"
                         Background="{DynamicResource Brush.BackgroundElevated}"
                         Foreground="{DynamicResource Brush.Text}"
                         BorderBrush="{DynamicResource Brush.Border}" Margin="0,0,8,0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding AddFromUrlCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="1" Content="貼り付けて追加"
                        Command="{Binding AddFromUrlCommand}"
                        Padding="10,6"
                        Background="{DynamicResource Brush.Accent}"
                        Foreground="{DynamicResource Brush.OnAccent}"
                        BorderThickness="0" />
            </Grid>
        </Border>

        <!-- コンテンツ: 左=チャンネルツリー(Phase4b) / 右=動画一覧(Phase4c) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" x:Name="ChannelTreeColumn" MinWidth="150" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" x:Name="VideoListColumn" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" x:Name="ChannelTreeHost"
                    Background="{DynamicResource Brush.Background}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
                <ListBox ItemsSource="{Binding TreeNodes}"
                         SelectedItem="{Binding SelectedTreeNode}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ContextMenu>
                        <!--
                            ContextMenuはPopupの別ツリーに属しDataContextを継承しないため、
                            PlacementTarget(=このListBox)のDataContext(=MainViewModel)を
                            明示的に引き継がせる。これで配下のMenuItemは通常通り{Binding XCommand}で書ける。
                        -->
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{loc:T MainForm_menuChCheckNow}" Command="{Binding CheckChannelNowCommand}" />
                            <MenuItem Header="{loc:T MainForm_menuChEnable}" Command="{Binding EnableChannelCommand}" />
                            <MenuItem Header="{loc:T MainForm_menuChDisable}" Command="{Binding DisableChannelCommand}" />
                            <Separator />
                            <MenuItem Header="{loc:T MainForm_menuChDelete}" Command="{Binding DeleteChannelCommand}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BackgroundHover}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BackgroundElevated}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}"
                                       Foreground="{Binding Foreground}"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBold}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                           Background="{DynamicResource Brush.Border}" />

            <Border Grid.Column="2" x:Name="VideoListHost"
                    Background="{DynamicResource Brush.Background}">
                <!--
                    動画一覧: ListViewの既定パネルはVirtualizingStackPanelのため、
                    IsVirtualizing/VirtualizationMode を明示しなくても4万件規模で
                    可視行のみUI要素化される(旧WinForms版のVirtualModeに相当)。
                -->
                <ListView ItemsSource="{Binding Videos}"
                          SelectedItem="{Binding SelectedVideo}"
                          Background="Transparent" BorderThickness="0"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ContextMenuOpening="VideoList_ContextMenuOpening">
                    <!--
                        各MenuItemのVisibilityはMainViewModel.RefreshVideoContextMenuState()が
                        メニューを開く直前(ContextMenuOpening)に計算するCanXxxSelectedVideo系の
                        プロパティにバインドする(旧WinForms版menuVideoContext_Openingに相当)。
                    -->
                    <ListView.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{Binding DownloadMenuText}" Command="{Binding DownloadVideoCommand}"
                                      Visibility="{Binding CanDownloadSelectedVideo, Converter={StaticResource BoolToVis}}" />
                            <MenuItem Header="{loc:T MainForm_menuVidCancel}" Command="{Binding CancelVideoCommand}"
                                      Visibility="{Binding CanCancelSelectedVideo, Converter={StaticResource BoolToVis}}" />
                            <MenuItem Header="{loc:T MainForm_menuVidRetryFailed}" Command="{Binding RetryFailedVideoCommand}"
                                      Visibility="{Binding CanRetryFailedSelectedVideo, Converter={StaticResource BoolToVis}}" />
                            <MenuItem Header="{loc:T MainForm_menuVidReDownload}" Command="{Binding ReDownloadVideoCommand}"
                                      Visibility="{Binding CanReDownloadSelectedVideo, Converter={StaticResource BoolToVis}}" />
                            <MenuItem Header="{loc:T MainForm_menuVidRefreshInfo}" Command="{Binding RefreshVideoInfoCommand}"
                                      Visibility="{Binding CanRefreshInfoSelectedVideo, Converter={StaticResource BoolToVis}}" />
                            <MenuItem Header="{loc:T MainForm_menuVidCheckFileExists}" Command="{Binding CheckFileExistsForSelectedVideoCommand}"
                                      Visibility="{Binding CanCheckFileExistsSelectedVideo, Converter={StaticResource BoolToVis}}" />
                            <MenuItem Header="{loc:T MainForm_menuVidMapLocalFile}" Command="{Binding MapLocalFileCommand}"
                                      Visibility="{Binding CanMapLocalFileSelectedVideo, Converter={StaticResource BoolToVis}}" />
                            <Separator />
                            <MenuItem Header="{loc:T MainForm_menuVidPlay}" Command="{Binding PlayVideoCommand}"
                                      Visibility="{Binding CanPlaySelectedVideo, Converter={StaticResource BoolToVis}}" />
                            <MenuItem Header="{loc:T MainForm_menuVidOpenFolder}" Command="{Binding OpenVideoFolderCommand}"
                                      Visibility="{Binding CanOpenFolderSelectedVideo, Converter={StaticResource BoolToVis}}" />
                            <Separator />
                            <MenuItem Header="{loc:T MainForm_menuVidOpenPage}" Command="{Binding OpenVideoPageCommand}" />
                            <MenuItem Header="{loc:T MainForm_menuVidOpenAuthor}" Command="{Binding OpenVideoAuthorPageCommand}"
                                      Visibility="{Binding CanOpenAuthorSelectedVideo, Converter={StaticResource BoolToVis}}" />
                            <MenuItem Header="{loc:T MainForm_menuVidCopyUrl}" Command="{Binding CopyVideoUrlCommand}" />
                            <MenuItem Header="{loc:T MainForm_menuVidCopyTitle}" Command="{Binding CopyVideoTitleCommand}" />
                            <Separator />
                            <MenuItem Header="{Binding FavoriteMenuText}" Command="{Binding ToggleFavoriteCommand}"
                                      Visibility="{Binding IsNormalNodeSelected, Converter={StaticResource BoolToVis}}" />
                            <MenuItem Header="{loc:T MainForm_menuVidDetails}" Command="{Binding OpenVideoDetailsCommand}"
                                      Visibility="{Binding IsNormalNodeSelected, Converter={StaticResource BoolToVis}}" />
                            <Separator />
                            <MenuItem Header="{loc:T MainForm_menuVidDelete}" Command="{Binding DeleteVideoCommand}"
                                      Visibility="{Binding IsNormalNodeSelected, Converter={StaticResource BoolToVis}}" />
                            <Separator Visibility="{Binding IsExcludedNodeSelected, Converter={StaticResource BoolToVis}}" />
                            <MenuItem Header="{loc:T MainForm_menuVidRestore}" Command="{Binding RestoreVideoCommand}"
                                      Visibility="{Binding IsExcludedNodeSelected, Converter={StaticResource BoolToVis}}" />
                            <MenuItem Header="{loc:T MainForm_menuVidPermanentDelete}" Command="{Binding PermanentDeleteVideoCommand}"
                                      Visibility="{Binding IsExcludedNodeSelected, Converter={StaticResource BoolToVis}}" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{loc:T MainForm_colVideoTitle}" Width="400" DisplayMemberBinding="{Binding Title}" />
                            <GridViewColumn Header="{loc:T MainForm_colVideoSource}" Width="80" DisplayMemberBinding="{Binding Source}" />
                            <GridViewColumn Header="{loc:T MainForm_colVideoStatus}" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusForeground}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{loc:T MainForm_colVideoProgress}" Width="120" DisplayMemberBinding="{Binding ProgressText}" />
                            <GridViewColumn Header="{loc:T MainForm_colVideoSize}" Width="90" DisplayMemberBinding="{Binding FileSize}" />
                            <GridViewColumn Header="{loc:T MainForm_colVideoDate}" Width="140" DisplayMemberBinding="{Binding CreatedAt}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </Grid>

        <!-- ステータスバー -->
        <Border Grid.Row="3" x:Name="StatusBarHost"
                Background="{DynamicResource Brush.BackgroundElevated}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource Brush.Text}" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding DownloadCountText}"
                           Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11"
                           VerticalAlignment="Center" Margin="12,0" />
                <ProgressBar Grid.Column="2" Value="{Binding ProgressBarValue, Mode=OneWay}"
                             Minimum="0" Maximum="100" Height="14" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding FreeSpaceText}"
                           Foreground="{Binding FreeSpaceForeground}" FontSize="11"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
