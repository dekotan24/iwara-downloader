<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF段階移行 (strangler-fig方式): WinFormsと恒久的に共存させる。理由はメモ参照 -->
    <UseWPF>true</UseWPF>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>IwaraDownloader</AssemblyName>
    <RootNamespace>IwaraDownloader</RootNamespace>
    <Version>3.0.0</Version>
    <Authors>deko</Authors>
    <Description>Iwara video downloader</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Title>IwaraDownloader</Title>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/dekotan24/iwara-downloader</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- 多言語対応: ニュートラルリソース(Strings.resx)は日本語。en/zh-Hansはサテライトアセンブリ -->
    <NeutralResourcesLanguage>ja</NeutralResourcesLanguage>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <!-- WPF移行中はXAMLバインディング/null参照系のスタックトレースに行番号が要るため portable に変更 -->
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWPF+UseWindowsForms併用でSDKの既定ImplicitUsings一覧からSystem.IO/System.Net.Httpが
         抜け落ちる既知の挙動があるため、プロジェクト全体へ明示的に復元する -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Services\BrowserService.cs.old" />
    <None Remove="Services\YtDlpService.cs.old" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF側でpack://siteoforigin:,,,/icon.ico として実行フォルダから読むため出力へコピーする
         (元々はApplicationIconとしてexeへの埋め込み専用で、出力フォルダへのコピー指定が無かった) -->
    <Content Include="icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="WebUI\**" CopyToOutputDirectory="PreserveNewest" LinkBase="WebUI" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- SQLite for database -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <!-- Microsoft.Data.Sqlite間接依存のSQLitePCLRaw 2.1.11以下にSQLite側の既知脆弱性(GHSA-2m69-gcr7-jv3q)があるため明示的に新しいバイナリへ固定 -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />

    <!-- NAudio for completion sound -->
    <PackageReference Include="NAudio" Version="2.2.1" />

    <!-- TagLib# for mp4 metadata (UUID tagging) -->
    <PackageReference Include="TagLibSharp" Version="2.3.0" />

    <!-- WPF移行用 MVVM ツールキット (ソースジェネレータ、公式) -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="VirtualizingWrapPanel" Version="2.5.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="iwara_helper.py">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="iwara_setup.bat">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="task_complete.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="task_error.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
